<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
    <layer-list>
        <item>
            <shape>
                <solid android:color="#00000000" />
                <stroke android:width="2dp" android:color="#E6FFFFFF" />
                <corners android:radius="19dp" />
            </shape>
        </item>
        <item>
            <inset android:inset="4dp">
                <shape>
                    <gradient android:angle="270" android:startColor="#FF4A5D86" android:endColor="#FF202B45" />
                    <stroke android:width="1dp" android:color="#40FFFFFF" />
                    <corners android:radius="15dp" />
                </shape>
            </inset>
        </item>
    </layer-list>
    </item>
    <item>
    <layer-list>
        <item>
            <inset android:inset="4dp">
                <shape>
                    <gradient android:angle="270" android:startColor="#FF3D4E72" android:endColor="#FF1C263D" />
                    <stroke android:width="1dp" android:color="#55A0B8FF" />
                    <corners android:radius="15dp" />
                </shape>
            </inset>
        </item>
    </layer-list>
    </item>
</selector>
