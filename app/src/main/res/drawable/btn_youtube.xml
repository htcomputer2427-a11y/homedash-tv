<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
    <layer-list>
        <item>
            <shape>
                <solid android:color="#00000000" />
                <stroke android:width="2dp" android:color="#E6FFFFFF" />
                <corners android:radius="19dp" />
            </shape>
        </item>
        <item>
            <inset android:inset="4dp">
                <shape>
                    <gradient android:angle="270" android:startColor="#FFF5524D" android:endColor="#FFC9141B" />
                    <stroke android:width="1dp" android:color="#40FFFFFF" />
                    <corners android:radius="15dp" />
                </shape>
            </inset>
        </item>
    </layer-list>
    </item>
    <item>
    <layer-list>
        <item>
            <inset android:inset="4dp">
                <shape>
                    <gradient android:angle="270" android:startColor="#FFE8403B" android:endColor="#FFB01218" />
                    <stroke android:width="1dp" android:color="#55FF9A9A" />
                    <corners android:radius="15dp" />
                </shape>
            </inset>
        </item>
    </layer-list>
    </item>
</selector>
