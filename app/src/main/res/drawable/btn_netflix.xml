<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
    <layer-list>
        <item>
            <shape>
                <solid android:color="#00000000" />
                <stroke android:width="2dp" android:color="#E6FFFFFF" />
                <corners android:radius="19dp" />
            </shape>
        </item>
        <item>
            <inset android:inset="4dp">
                <shape>
                    <gradient android:angle="270" android:startColor="#FF2A2A2A" android:endColor="#FF050505" />
                    <stroke android:width="1dp" android:color="#40FFFFFF" />
                    <corners android:radius="15dp" />
                </shape>
            </inset>
        </item>
    </layer-list>
    </item>
    <item>
    <layer-list>
        <item>
            <inset android:inset="4dp">
                <shape>
                    <gradient android:angle="270" android:startColor="#FF222222" android:endColor="#FF000000" />
                    <stroke android:width="1dp" android:color="#40FFFFFF" />
                    <corners android:radius="15dp" />
                </shape>
            </inset>
        </item>
    </layer-list>
    </item>
</selector>
