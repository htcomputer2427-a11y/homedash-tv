<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Dash" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="T">
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:fontFamily">@font/outfit_regular</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:shadowColor">#66000000</item>
        <item name="android:shadowRadius">3</item>
        <item name="android:shadowDy">1</item>
    </style>
    <style name="T.Medium">
        <item name="android:fontFamily">@font/outfit_medium</item>
    </style>
    <style name="T.Bold">
        <item name="android:fontFamily">@font/outfit_bold</item>
    </style>
    <style name="T.Dim">
        <item name="android:textColor">#CCFFFFFF</item>
    </style>
    <!-- Card header: title, then "Cập nhật hh:mm" and the refresh glyph. -->
    <style name="T.CardTitle" parent="T.Medium">
        <item name="android:textSize">12sp</item>
    </style>
    <style name="T.Updated" parent="T.Dim">
        <item name="android:textSize">8sp</item>
    </style>
    <style name="T.RowLabel" parent="T">
        <item name="android:textSize">11.5sp</item>
    </style>
    <style name="T.Change" parent="T.Medium">
        <item name="android:textSize">10sp</item>
    </style>
    <style name="T.Unit" parent="T.Dim">
        <item name="android:textSize">9sp</item>
    </style>
    <style name="BigValue" parent="T.Bold">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
</resources>
