<?xml version="1.0" encoding="utf-8"?>
<!-- Laid out for a 960x540dp TV screen (1920x1080 at xhdpi). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sunset">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- Top right: Inputs, Settings | Wi-Fi -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="26dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_voice"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/icon_btn_bg"
            android:contentDescription="Lệnh giọng nói"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mic" />

        <ImageButton
            android:id="@+id/btn_inputs"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/icon_btn_bg"
            android:contentDescription="Nguồn vào"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_input" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/icon_btn_bg"
            android:contentDescription="Cài đặt"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_marginHorizontal="10dp"
            android:background="#80FFFFFF" />

        <ImageButton
            android:id="@+id/btn_wifi"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/icon_btn_bg"
            android:contentDescription="Wi-Fi"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_wifi" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingTop="52dp"
        android:paddingEnd="30dp">

        <!-- Calendar -->
        <!-- As tall as the clock, price and music cards together (110 + 8 + 136 + 8 + 122). -->
        <LinearLayout
            android:layout_width="212dp"
            android:layout_height="384dp"
            android:background="@drawable/card_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="14dp">

            <TextView
                android:id="@+id/cal_month"
                style="@style/T.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFE7C2"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/cal_day"
                style="@style/T.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFeatureSettings="tnum"
                android:shadowRadius="0"
                android:textSize="112sp" />

            <TextView
                android:id="@+id/cal_weekday"
                style="@style/T.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FFFFD36E"
                android:textSize="23sp" />

            <View
                android:layout_width="150dp"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="#55FFFFFF" />

            <!-- "Âm lịch", or the holiday's name on a holiday. -->
            <TextView
                android:id="@+id/cal_label"
                style="@style/T"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Âm lịch"
                android:textSize="12.5sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cal_lunar"
                    style="@style/T.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFD54A"
                    android:textSize="34sp" />

                <!-- RẰM / MÙNG 1 -->
                <TextView
                    android:id="@+id/cal_lunar_tag"
                    style="@style/T.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/tag_bg"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:shadowRadius="0"
                    android:textColor="#FF3A2A00"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/cal_lunar_year"
                style="@style/T"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/cal_lunar_month"
                style="@style/T"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/cal_lunar_day"
                style="@style/T"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Greeting, clock and weather -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:background="@drawable/card_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/greeting"
                        style="@style/T.Medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp" />

                    <!-- Hours and minutes in the sunset gradient, the seconds apart in one colour. -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/clock"
                            style="@style/T.Bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:shadowRadius="0"
                            android:text="00:00"
                            android:textSize="68sp" />

                        <TextView
                            android:id="@+id/clock_sec"
                            style="@style/T.Bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:text=":00"
                            android:textColor="#FFFFB27A"
                            android:textSize="68sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="70dp"
                    android:layout_marginHorizontal="22dp"
                    android:background="#55FFFFFF" />

                <ImageView
                    android:id="@+id/weather_icon"
                    android:layout_width="68dp"
                    android:layout_height="60dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_w_partly" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/temp"
                        style="@style/T.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—°"
                        android:textSize="36sp" />

                    <TextView
                        android:id="@+id/city"
                        style="@style/T"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textSize="13.5sp" />

                    <TextView
                        android:id="@+id/weather_text"
                        style="@style/T"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Gold, USD/VND, fuel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="136dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/card_gold"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="231"
                    android:background="@drawable/card_bg"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingHorizontal="11dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="6dp">

                    <include android:id="@+id/gold_header" layout="@layout/card_header" />
                    <include android:id="@+id/gold_sjc" layout="@layout/row_price" />
                    <include android:id="@+id/gold_ring" layout="@layout/row_price" />
                    <include android:id="@+id/gold_610" layout="@layout/row_price" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_fx"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="210"
                    android:background="@drawable/card_bg"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingHorizontal="11dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp">

                    <include android:id="@+id/fx_header" layout="@layout/card_header" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/panel_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="12dp">

                            <TextView
                                style="@style/T.RowLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mua vào" />

                            <TextView
                                android:id="@+id/fx_buy"
                                style="@style/BigValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="—"
                                android:textSize="21sp" />

                            <TextView
                                android:id="@+id/fx_buy_change"
                                style="@style/T.Change"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="#40FFFFFF" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="12dp">

                            <TextView
                                style="@style/T.RowLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bán ra" />

                            <TextView
                                android:id="@+id/fx_sell"
                                style="@style/BigValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="—"
                                android:textSize="21sp" />

                            <TextView
                                android:id="@+id/fx_sell_change"
                                style="@style/T.Change"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        style="@style/T.Unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="5dp"
                        android:text="Đơn vị: VND/USD · Vietcombank"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_fuel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="216"
                    android:background="@drawable/card_bg"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingHorizontal="11dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="6dp">

                    <include android:id="@+id/fuel_header" layout="@layout/card_header" />
                    <include android:id="@+id/fuel_e10" layout="@layout/row_price" />
                    <include android:id="@+id/fuel_e5" layout="@layout/row_price" />
                    <include android:id="@+id/fuel_do" layout="@layout/row_price" />
                </LinearLayout>
            </LinearLayout>

            <!-- Music: what YouTube / YouTube Music is playing -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="122dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <FrameLayout
                    android:id="@+id/music_art_frame"
                    android:layout_width="134dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/art_bg"
                    android:focusable="true"
                    android:padding="2dp">

                    <ImageView
                        android:id="@+id/music_art"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="center"
                        android:src="@drawable/ic_note" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/music_title"
                            style="@style/T.Bold"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Chưa phát nhạc"
                            android:textSize="17sp" />

                        <LinearLayout
                            android:id="@+id/music_playlist"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:background="@drawable/pill_bg"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="10dp">

                            <ImageView
                                android:id="@+id/music_playlist_icon"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_playlist" />

                            <TextView
                                android:id="@+id/music_playlist_text"
                                style="@style/T"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:shadowRadius="0"
                                android:text="Danh sách phát"
                                android:textSize="10.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/music_artist"
                        style="@style/T.Dim"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Mở YouTube Music để phát"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/music_position"
                            style="@style/T.Dim"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="9dp"
                            android:fontFeatureSettings="tnum"
                            android:text="00:00"
                            android:textSize="10.5sp" />

                        <ProgressBar
                            android:id="@+id/music_progress"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="0dp"
                            android:layout_height="5dp"
                            android:layout_weight="1"
                            android:max="1000"
                            android:progressDrawable="@drawable/progress_track" />

                        <TextView
                            android:id="@+id/music_duration"
                            style="@style/T.Dim"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:fontFeatureSettings="tnum"
                            android:text="00:00"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/music_shuffle"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:alpha="0.85"
                            android:importantForAccessibility="no"
                            android:padding="5dp"
                            android:src="@drawable/ic_shuffle" />

                        <ImageButton
                            android:id="@+id/music_prev"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="22dp"
                            android:background="@drawable/ctrl_bg"
                            android:contentDescription="Bài trước"
                            android:padding="6dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_prev" />

                        <ImageButton
                            android:id="@+id/music_play"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginHorizontal="24dp"
                            android:background="@drawable/play_bg"
                            android:contentDescription="Phát hoặc tạm dừng"
                            android:padding="9dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_play" />

                        <ImageButton
                            android:id="@+id/music_next"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/ctrl_bg"
                            android:contentDescription="Bài tiếp theo"
                            android:padding="6dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_next" />

                        <ImageView
                            android:id="@+id/music_repeat"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginStart="22dp"
                            android:alpha="0.85"
                            android:importantForAccessibility="no"
                            android:padding="5dp"
                            android:src="@drawable/ic_repeat" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/queue"
                    android:layout_width="182dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <include android:id="@+id/queue_0" layout="@layout/row_queue" />
                    <include android:id="@+id/queue_1" layout="@layout/row_queue" />
                    <include android:id="@+id/queue_2" layout="@layout/row_queue" />
                </LinearLayout>
            </LinearLayout>

            <!-- App buttons, with their reflections under them -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="9dp"
                android:orientation="horizontal">

                <include android:id="@+id/app_youtube" layout="@layout/app_button" />
                <include android:id="@+id/app_netflix" layout="@layout/app_button" />
                <include android:id="@+id/app_store" layout="@layout/app_button" />
                <include android:id="@+id/app_all" layout="@layout/app_button" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
